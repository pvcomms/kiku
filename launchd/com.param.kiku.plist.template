<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A template, not a plist to load as is. bin/install-launchd fills __HOME__, __REPO__ and
     __NODE__ for this machine, writes ~/Library/LaunchAgents/com.param.kiku.plist and loads it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.param.kiku</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/src/server.ts</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>KIKU_PORT</key><string>4747</string>
    <key>KIKU_HOME</key><string>__HOME__/Kiku</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/kiku.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/kiku.log</string>
</dict>
</plist>
