    "mailparser": "^3.9.31",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.1",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
