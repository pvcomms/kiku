#!/bin/sh
# install-launchd — keep kiku running: start at login, restart on crash.
# Renders launchd/com.param.kiku.plist.template for this machine (home directory, where this
# clone lives, which node) into ~/Library/LaunchAgents/com.param.kiku.plist and loads it.
#   bin/install-launchd            install or reinstall, then start; answers on this Mac only
#   bin/install-launchd --lan      the same, but answering on the home network (KIKU_HOST=0.0.0.0)
#   bin/install-launchd --print    print the rendered plist to stdout and change nothing
set -eu
LABEL=com.param.kiku
REPO=$(cd "$(dirname "$0")/.." && pwd)
NODE=$(command -v node) || { echo "install-launchd: node is not on PATH" >&2; exit 1; }

HOST=127.0.0.1
PRINT=0
for a in "$@"; do
  case "$a" in
    --lan) HOST=0.0.0.0 ;;
    --print) PRINT=1 ;;
    *) echo "usage: bin/install-launchd [--lan] [--print]" >&2; exit 2 ;;
  esac
done

render() {
  sed -e "s|__HOME__|$HOME|g" -e "s|__REPO__|$REPO|g" -e "s|__NODE__|$NODE|g" -e "s|__HOST__|$HOST|g" \
    "$REPO/launchd/$LABEL.plist.template"
}

if [ "$PRINT" = 1 ]; then render; exit 0; fi

DEST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"
mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
render > "$DEST"
plutil -lint "$DEST" >/dev/null
launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
launchctl bootstrap "$DOMAIN" "$DEST"
echo "installed $DEST and started $LABEL"
if [ "$HOST" = 0.0.0.0 ]; then
  echo "page     http://$(hostname -s | tr '[:upper:]' '[:lower:]').local:4747"
else
  echo "page     http://localhost:4747   (this Mac only; --lan opens it to the home network)"
fi
echo "log      tail -f ~/Library/Logs/kiku.log"
echo "restart  launchctl kickstart -k $DOMAIN/$LABEL"
