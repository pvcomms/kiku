#!/usr/bin/env node
// doctor — what this machine has, what it is missing, and the command that closes each gap.
//   bin/doctor           the full report, including the slow check that the speech stack imports
//   bin/doctor --quick   skip the slow check
//   bin/doctor --json    the report as JSON, for scripts
// Exits 1 when anything is missing. Runs against the code in this clone, not the server, so it
// works before the server has ever started.
import { check } from "../src/preflight.ts";

const args = new Set(process.argv.slice(2));
const report = await check({ deep: !args.has("--quick") });

if (args.has("--json")) {
  console.log(JSON.stringify(report, null, 2));
} else {
  // `ok` has it; `--` a reading cannot happen without it; `off` one half of kiku is without it.
  const width = Math.max(...report.checks.map((c) => c.name.length));
  for (const c of report.checks) {
    const mark = c.ok ? "ok " : c.level === "need" ? "-- " : "off";
    console.log(`${mark} ${c.name.padEnd(width)}  ${c.detail}`);
    if (!c.ok && c.fix) console.log(`${" ".repeat(width + 6)}fix: ${c.fix}`);
  }
  const off = report.checks.filter((c) => !c.ok && c.level === "want").length;
  console.log(
    report.ok
      ? `\nready: everything a reading needs is here.${off ? ` ${off} optional thing${off > 1 ? "s are" : " is"} off.` : ""}`
      : "\nnot ready: run each fix above, then bin/doctor again.",
  );
}
process.exit(report.ok ? 0 : 1);
